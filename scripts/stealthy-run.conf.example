# StealthyPrivesc automated dispatcher manifest.
# Example of the context carried by a staged primary run. The generated
# manifest binds to the current host automatically. This records inherited
# authorization; it does not grant permission or override host policy.

manifest_version=1
authorization_ack=true
# The manifest approves the execution path; each dispatch still requires a
# fresh --authorized flag or STEALTHY_AUTHORIZED=1 acknowledgment.
operator_ack_required=true
allow_fallback=true
roe_ref=INHERITED_PRIMARY_RUN
execution_mode=enumerate-only
# native-with-fallbacks or script-only. Script-only requires an empty primary_binary.
bundle_mode=native-with-fallbacks
target_hostname=SET_TARGET_HOSTNAME
target_username=
# Empty: run the primary in place (Linux and Windows). Set a path only when
# the dispatcher should copy the binary and scripts to a separate directory.
drop_dir=
primary_binary=stealthy
# auto: skip the primary when a live endpoint sensor (or Linux noexec mount)
# is observed. true: always start on approved script hosts. false: try the
# primary first. STEALTHY_SCRIPT_FIRST overrides this at dispatch time.
script_first=auto
# Ordered hosts tried after a skipped or blocked primary. Script tiers are
# fixed enumerate-only reduced coverage (only auth + --json are forwarded).
linux_fallbacks=python,bash,sh,perl
windows_fallbacks=python,pwsh,powershell,git,jscript,msbuild
